{
  "name": "marbot-fichas",
  "productName": "Marbot Fichas",
  "description": "Fichas de custo, receitas e financeiro da confeitaria Marbot Ateliê",
  "author": "Vitor Marquez",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "start": "vite build && electron .",
    "portable": "vite build && electron-builder --win --x64 --dir && node electron/makePortable.cjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "pluggy-connect-sdk": "^2.14.2",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resedit": "^3.1.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "br.com.marbotatelie.fichas",
    "productName": "Marbot Fichas",
    "copyright": "Marbot Ateliê",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "afterPack": "electron/afterPack.cjs",
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    }
  }
}
