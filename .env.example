# Copie este arquivo para ".env.local" e preencha com os seus valores.
# O .env.local NÃO vai para o GitHub (está no .gitignore).
# Tudo aqui é opcional: o que ficar vazio pode ser preenchido depois em Configurações, dentro do app.

# IA gratuita — chave do Gemini (https://aistudio.google.com/apikey, plano gratuito)
VITE_DEFAULT_GEMINI_KEY=

# Login com o Google — cliente OAuth do tipo "App para computador" (console.cloud.google.com)
# Precisa das APIs Google Sheets e Google Drive ativadas no projeto.
VITE_DEFAULT_GOOGLE_CLIENT_ID=
VITE_DEFAULT_GOOGLE_CLIENT_SECRET=

# Planilha das fichas de custo (o ID é o trecho entre /d/ e /edit no link da planilha)
VITE_DEFAULT_SPREADSHEET_ID=

# Notion — link ou ID da página/base onde as receitas são salvas (o token fica só no app)
VITE_DEFAULT_NOTION_TARGET=

# Financeiro — planilha do extrato e endereço da função publicada na Vercel (pasta vercel/)
VITE_DEFAULT_FINANCE_SHEET_ID=
VITE_DEFAULT_FINANCE_FUNCTION_URL=https://SEU-PROJETO.vercel.app/api/financeiro
